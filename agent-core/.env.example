# Copy to .env.local and fill in. eve dev loads .env.local automatically.

# xAI / Grok API key (grok.com dashboard or console.x.ai — try grok.com first)
XAI_API_KEY=

# Optional: Grok model id (default grok-4.7)
# GROK_MODEL=grok-4.7

# Optional: model for the news search tool (default: GROK_MODEL)
# GROK_SEARCH_MODEL=grok-4.7

# --- Phone / Grok Voice (see docs/phone-voice.md) ---
# XAI_VOICE_WEBHOOK_SECRET=whsec_...
# BRC_PUBLIC_BASE_URL=https://your-tunnel.example
# BRC_PHONE_ALLOWLIST=+393331234567
# BRC_PHONE_DEMO_OPEN=1
# XAI_SPEECH_VOICE=eve
